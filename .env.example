# Copy to .env for local overrides. All values are non-secret defaults.
SB_APP_NAME="SecondBrain AI"
SB_ENVIRONMENT=local
SB_DEBUG=false
SB_DATABASE_PATH=data/secondbrain.db
SB_DOCUMENT_STORAGE_PATH=data/documents
SB_MAX_UPLOAD_SIZE_BYTES=10485760
# Optional Cohere text generation settings; configure both to use the provider.
# SB_COHERE_API_KEY=
# SB_COHERE_MODEL=your-cohere-chat-model
SB_COHERE_TIMEOUT_SECONDS=30.0
